generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum HireStatus {
  INTERVIEWING
  HIRED
  ONBOARDING
  ACTIVE
  ON_HOLD
  REJECTED
}

enum CompensationType {
  SALARY
  PERCENTAGE
}

enum PunishmentStatus {
  PENDING
  DONE
  FORGIVEN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  createdTasks    Task[]        @relation("CreatedTasks")
  assignedTasks   Task[]        @relation("AssignedTasks")
  completedTasks  Task[]        @relation("CompletedTasks")
  historyEntries  TaskHistory[]
  notifications   Notification[]
  addedHires      Hire[]
  punishmentsReceived Punishment[] @relation("PunishmentUser")
  punishmentsIssued   Punishment[] @relation("PunishmentIssuedBy")
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  status        Status    @default(PENDING)
  priority      Priority  @default(MEDIUM)
  dueDate       DateTime?
  tags          String[]  @default([])

  assignedToId  String?
  assignedTo    User?     @relation("AssignedTasks", fields: [assignedToId], references: [id])

  createdById   String
  createdBy     User      @relation("CreatedTasks", fields: [createdById], references: [id])

  completedById String?
  completedBy   User?     @relation("CompletedTasks", fields: [completedById], references: [id])
  completedAt   DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  history       TaskHistory[]
  notifications Notification[]
  punishments   Punishment[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdById])
  @@index([createdAt])
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action    String
  byId      String
  by        User     @relation(fields: [byId], references: [id])
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model CompensationRange {
  id         String   @id @default(cuid())
  label      String   // e.g. "$400 - $500" or "Standard rate"
  isFlat     Boolean  @default(false) // true = flat percentage that applies to every project, no range
  minValue   Float?   // lower bound of the price range (inclusive); null when isFlat
  maxValue   Float?   // upper bound of the price range (inclusive); null = "and above", or when isFlat
  percentage Float    // the percentage rate to apply

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([minValue])
}

model Hire {
  id     String @id @default(cuid())
  name   String
  email  String?
  phone  String?
  role   String  // position they're being hired for

  compensationType  CompensationType @default(SALARY)
  compensationValue Float?           // salary amount, or percentage rate
  compensationRangeIds String[] @default([]) // ids of selected CompensationRange presets (multi-select tags)

  status HireStatus @default(INTERVIEWING)
  source String?    // e.g. referral, LinkedIn, Upwork
  notes  String?

  startDate DateTime?

  addedById String
  addedBy   User   @relation(fields: [addedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([addedById])
}

model Punishment {
  id         String            @id @default(cuid())
  reason     String
  punishment String
  status     PunishmentStatus  @default(PENDING)
  dueDate    DateTime?

  userId     String
  user       User              @relation("PunishmentUser", fields: [userId], references: [id], onDelete: Cascade)

  issuedById String
  issuedBy   User              @relation("PunishmentIssuedBy", fields: [issuedById], references: [id])

  taskId     String?
  task       Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([dueDate])
}
